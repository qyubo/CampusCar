<?xml version="1.0"?>
<!-- 单板单串口模式：一块 STM32 通过一个串口控制全部 4 个轮子 -->
<!-- ros2_control 只暴露 2 个关节 (left/right)，ESC 统一驱动 4 轮 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="campuscar_single_board">

  <xacro:arg name="prefix"            default=""/>
  <xacro:arg name="device"           default="/dev/ttyUSB0"/>
  <xacro:arg name="feedback_format"  default="compact"/>
  <xacro:arg name="wheel_radius"     default="0.0825"/>
  <xacro:arg name="max_velocity"     default="1.0"/>
  <xacro:arg name="command_limit_rpm" default="50"/>

  <xacro:include filename="$(find hoverboard_driver)/urdf/diffbot.materials.xacro"/>
  <xacro:include filename="$(find hoverboard_driver)/ros2_control/hoverboard_driver.ros2_control.xacro"/>

  <!-- ======== 机器人本体 ======== -->
  <xacro:property name="PI"           value="3.1415926535897931"/>
  <xacro:property name="base_mass"    value="10.0"/>
  <xacro:property name="base_length"  value="0.60"/>
  <xacro:property name="base_width"   value="0.45"/>
  <xacro:property name="base_height"  value="0.10"/>
  <xacro:property name="wheel_mass"   value="1.5"/>
  <xacro:property name="wheel_radius_val" value="0.0825"/>
  <xacro:property name="wheel_len"    value="0.055"/>
  <xacro:property name="axle_offset_y" value="${base_width / 2.0}"/>

  <link name="${prefix}base_link">
    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${base_mass / 12.0 * (base_width*base_width   + base_height*base_height)}" ixy="0" ixz="0"
        iyy="${base_mass / 12.0 * (base_length*base_length + base_height*base_height)}" iyz="0"
        izz="${base_mass / 12.0 * (base_length*base_length + base_width*base_width)}"/>
    </inertial>
  </link>

  <!-- ======== 左轮 ======== -->
  <joint name="${prefix}left_wheel_joint" type="continuous">
    <parent link="${prefix}base_link"/>
    <child  link="${prefix}left_wheel"/>
    <origin xyz="0 ${axle_offset_y} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.2"/>
  </joint>
  <link name="${prefix}left_wheel">
    <collision>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder length="${wheel_len}" radius="${wheel_radius_val}"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder length="${wheel_len}" radius="${wheel_radius_val}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="${wheel_mass / 12.0 * (3*wheel_radius_val*wheel_radius_val + wheel_len*wheel_len)}" ixy="0" ixz="0"
        iyy="${wheel_mass / 12.0 * (3*wheel_radius_val*wheel_radius_val + wheel_len*wheel_len)}" iyz="0"
        izz="${wheel_mass / 2.0  *  wheel_radius_val*wheel_radius_val}"/>
    </inertial>
  </link>

  <!-- ======== 右轮 ======== -->
  <joint name="${prefix}right_wheel_joint" type="continuous">
    <parent link="${prefix}base_link"/>
    <child  link="${prefix}right_wheel"/>
    <origin xyz="0 ${-axle_offset_y} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.2"/>
  </joint>
  <link name="${prefix}right_wheel">
    <collision>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder length="${wheel_len}" radius="${wheel_radius_val}"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder length="${wheel_len}" radius="${wheel_radius_val}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="${wheel_mass / 12.0 * (3*wheel_radius_val*wheel_radius_val + wheel_len*wheel_len)}" ixy="0" ixz="0"
        iyy="${wheel_mass / 12.0 * (3*wheel_radius_val*wheel_radius_val + wheel_len*wheel_len)}" iyz="0"
        izz="${wheel_mass / 2.0  *  wheel_radius_val*wheel_radius_val}"/>
    </inertial>
  </link>

  <!-- ======== ros2_control 硬件接口 (单板单串口) ======== -->
  <xacro:hoverboard_axle_ros2_control
    name="HoverboardDriver"
    prefix="${prefix}"
    device="$(arg device)"
    wheel_radius="$(arg wheel_radius)"
    max_velocity="$(arg max_velocity)"
    command_limit_rpm="$(arg command_limit_rpm)"
    feedback_format="$(arg feedback_format)"/>

</robot>
