  <version>1.0.0</version>
  <description>Orbbec RGBD camera driver</description>
  <maintainer email="dev@cri.robot">CRI Team</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>cv_bridge</depend>
  <depend>sensor_msgs</depend>
