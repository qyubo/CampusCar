Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 500
  - Class: rviz_common/Views
    Expanded: ~
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: LivoxPointCloud
      Topic:
        Depth: 5
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Durability Policy: Volatile
        Value: /livox/pointcloud
      Size (Pixels): 3
      Style: Points
      Color Transformer: AxisColor
      Axis: Z
      Min Color: 0;0;0
      Max Color: 255;255;255
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: GroundCloud
      Topic:
        Depth: 5
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Durability Policy: Volatile
        Value: /perception/ground_cloud
      Size (Pixels): 3
      Style: Points
      Color Transformer: FlatColor
      Flat Color: 0;255;0
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: NongroundCloud
      Topic:
        Depth: 5
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Durability Policy: Volatile
        Value: /perception/nonground_cloud
      Size (Pixels): 3
      Style: Points
      Color Transformer: FlatColor
      Flat Color: 255;0;0
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: CameraImage
      Topic:
        Depth: 5
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Durability Policy: Volatile
        Value: /camera/image_raw
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: true
      Value: true
  Global Options:
    Background Color: 48;48;48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Publish
      Topic: /cmd_vel
      Topic Type: geometry_msgs/msg/Twist
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.785
      Yaw: 0.785
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
  X: 50
  Y: 50
