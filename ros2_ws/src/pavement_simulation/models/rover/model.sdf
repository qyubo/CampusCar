<?xml version="1.0" ?>
<!--
  CyberLuban 巡检机器人 Gazebo SDF 模型
  - 差速驱动底盘 (gz-sim DiffDrive 插件)
  - 3D LiDAR (模拟 Livox Mid-360: 360°水平, -7°~+7°垂直, 30m)
  - 工业相机 (640x480, 90°FOV)
  - IMU
  适配 Gazebo Fortress (SDF 1.7, ignition-gazebo6)
-->
<sdf version="1.7">
  <model name="rover">
    <pose>0 0 0.15 0 0 0</pose>

    <!-- ============ 底盘 (base_link) ============ -->
    <link name="base_link">
      <inertial>
        <mass>15.0</mass>
        <inertia>
          <ixx>0.12</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.20</iyy><iyz>0</iyz>
          <izz>0.28</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.50 0.40 0.15</size></box></geometry>
        <material>
          <ambient>0.2 0.4 0.8 1</ambient>
          <diffuse>0.2 0.4 0.8 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry><box><size>0.50 0.40 0.15</size></box></geometry>
      </collision>
      <sensor name="imu" type="imu">
        <topic>/imu/data</topic>
        <update_rate>50</update_rate>
        <pose>0 0 0.05 0 0 0</pose>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></z>
          </linear_acceleration>
        </imu>
        <always_on>true</always_on>
      </sensor>
    </link>

    <!-- ============ 左驱动轮 ============ -->
    <link name="left_wheel">
      <pose>0.0 0.25 0.0 1.5708 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.005</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.005</iyy><iyz>0</iyz>
          <izz>0.008</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.10</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.10</radius><length>0.05</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>50</mu><mu2>50</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics><damping>0.1</damping></dynamics>
      </axis>
    </joint>

    <!-- ============ 右驱动轮 ============ -->
    <link name="right_wheel">
      <pose>0.0 -0.25 0.0 1.5708 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.005</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.005</iyy><iyz>0</iyz>
          <izz>0.008</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.10</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.10</radius><length>0.05</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>50</mu><mu2>50</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics><damping>0.1</damping></dynamics>
      </axis>
    </joint>

    <!-- ============ 后万向轮 (caster, 球形无摩擦) ============ -->
    <link name="caster_wheel">
      <pose>-0.20 0.0 -0.02 0 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.0003</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0003</iyy><iyz>0</iyz>
          <izz>0.0003</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
        <surface>
          <friction>
            <ode><mu>0.01</mu><mu2>0.01</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="caster_joint" type="ball">
      <parent>base_link</parent>
      <child>caster_wheel</child>
    </joint>

    <!-- ============ LiDAR 传感器 (模拟 Livox Mid-360) ============ -->
    <link name="livox_frame">
      <pose>0.15 0.0 0.20 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.04</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
      </visual>
      <sensor name="livox_lidar" type="gpu_lidar">
        <topic>/livox/scan</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.1222</min_angle>
              <max_angle>0.1222</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.2</min>
            <max>30.0</max>
            <resolution>0.02</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </ray>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="livox_joint" type="fixed">
      <parent>base_link</parent>
      <child>livox_frame</child>
    </joint>

    <!-- ============ 相机 (工业相机) ============ -->
    <link name="camera_frame">
      <pose>0.25 0.0 0.12 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.04 0.06 0.04</size></box></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <sensor name="camera" type="camera">
        <topic>/camera/image</topic>
        <update_rate>10</update_rate>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>50</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </camera>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_frame</child>
    </joint>

    <!-- ============ IMU (在 base_link 内) ============ -->
    <!-- IMU 传感器已移入 base_link, 见上方 base_link 定义 -->

    <!-- ============ 差速驱动插件 ============ -->
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.50</wheel_separation>
      <wheel_radius>0.10</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>

    <!-- ============ 碰撞接触插件 ============ -->
    <plugin filename="ignition-gazebo-contact-system" name="ignition::gazebo::systems::Contact"/>

  </model>
</sdf>
