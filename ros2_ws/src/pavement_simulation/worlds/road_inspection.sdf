<?xml version="1.0" ?>
<!--
  CyberLuban 校园路面巡检 Gazebo 世界
  包含: 平面道路 + 路面缺陷(pothole/crack/沉降) + 环境障碍物
  适配 Gazebo Fortress (Ignition Gazebo 6, SDF 1.7)
-->
<sdf version="1.7">
  <world name="road_inspection_world">
    <!-- ============ 物理 ============ -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ============ 插件 ============ -->
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-contact-system" name="ignition::gazebo::systems::Contact"/>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ============ 光照 ============ -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.9 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <!-- ============ 道路地面 (30m x 20m 灰色平面) ============ -->
    <model name="road_ground">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>30 20</size></plane>
          </geometry>
          <material>
            <ambient>0.55 0.58 0.60 1</ambient>
            <diffuse>0.55 0.58 0.60 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>30 20</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>100</mu><mu2>100</mu2></ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

    <!-- ============ 车道线 (黄色虚线, 视觉参考) ============ -->
    <model name="lane_line_center">
      <static>true</static>
      <pose>0 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2.0 0.1 0.002</size></box></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============ 路面缺陷 1: Pothole 凹陷 (中心 3,-2, 半径0.4m, 深3cm) ============ -->
    <!-- 用深色矮圆柱体表示凹陷区域, 高度低于路面让雷达检测到高程突变 -->
    <model name="defect_pothole_1">
      <static>true</static>
      <pose>3.0 -2.0 0.0 0 0 0</pose>
      <link name="link">
        <visual name="visual_pit">
          <pose>0 0 -0.015 0 0 0</pose>
          <geometry><cylinder><radius>0.4</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
        <collision name="collision">
          <pose>0 0 -0.015 0 0 0</pose>
          <geometry><cylinder><radius>0.4</radius><length>0.03</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- ============ 路面缺陷 2: Crack 裂缝 (纵向, x=-3~-1, y=1, 宽0.1m, 深1.5cm) ============ -->
    <model name="defect_crack_1">
      <static>true</static>
      <pose>-2.0 1.0 0.0 0 0 0</pose>
      <link name="link">
        <visual name="visual_crack">
          <pose>0 0 -0.0075 0 0 0</pose>
          <geometry><box><size>2.0 0.1 0.015</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
        <collision name="collision">
          <pose>0 0 -0.0075 0 0 0</pose>
          <geometry><box><size>2.0 0.1 0.015</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ============ 路面缺陷 3: 沉降区域 (中心 -3,4, 半径1.5m, 深1cm) ============ -->
    <model name="defect_subsidence_1">
      <static>true</static>
      <pose>-3.0 4.0 0.0 0 0 0</pose>
      <link name="link">
        <visual name="visual_sub">
          <pose>0 0 -0.005 0 0 0</pose>
          <geometry><cylinder><radius>1.5</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.35 0.35 0.40 1</ambient><diffuse>0.30 0.30 0.35 1</diffuse></material>
        </visual>
        <collision name="collision">
          <pose>0 0 -0.005 0 0 0</pose>
          <geometry><cylinder><radius>1.5</radius><length>0.01</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- ============ 路面缺陷 4: 凸起 (中心 6,3, 小石块 0.15x0.15x0.04m) ============ -->
    <model name="defect_bump_1">
      <static>true</static>
      <pose>6.0 3.0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual_bump">
          <geometry><box><size>0.15 0.15 0.04</size></box></geometry>
          <material><ambient>0.4 0.3 0.2 1</ambient><diffuse>0.35 0.25 0.15 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.15 0.15 0.04</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ============ 环境障碍物: 路灯杆 ============ -->
    <model name="lamp_post_1">
      <static>true</static>
      <pose>5.0 -5.0 1.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>3.0</length></cylinder></geometry>
        </collision>
      </link>
    </model>
    <model name="lamp_post_2">
      <static>true</static>
      <pose>-5.0 5.0 1.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>3.0</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- ============ 道路边界墙 (防止机器人跑出场景) ============ -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 10 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>30 0.2 1.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>30 0.2 1.0</size></box></geometry></collision>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -10 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>30 0.2 1.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>30 0.2 1.0</size></box></geometry></collision>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>15 0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.2 20 1.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>0.2 20 1.0</size></box></geometry></collision>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-15 0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.2 20 1.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>0.2 20 1.0</size></box></geometry></collision>
      </link>
    </model>

  </world>
</sdf>
